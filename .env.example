# Bitbucket authentication (required for private repositories)
# Create a token at: https://bitbucket.org/[workspace]/[repo]/admin/access-tokens
BITBUCKET_USERNAME=your-username
BITBUCKET_API_TOKEN=your-api-token

# AI provider: ollama | claude-api | claude-cli
AI_PROVIDER=ollama

# Ollama local AI review settings (used when AI_PROVIDER=ollama)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=kimi-k2.6:cloud

# Claude cloud API settings (used when AI_PROVIDER=claude-api)
# Create a key at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8
ANTHROPIC_MAX_TOKENS=4096

# claude-cli provider needs no config — it shells out to the local `claude` CLI
# and reuses your existing Claude Code authentication.
